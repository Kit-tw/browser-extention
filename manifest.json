{
  "manifest_version": 3,
  "name": "Dev Dashboard",
  "version": "1.0.0",
  "chrome_url_overrides": { "newtab": "src/newtab/index.html" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://gitlab.com/*",
    "https://*.gitlab.com/*",
    "https://*.gitlab.example.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "src/background/service-worker.ts", "type": "module" },
  "options_page": "src/settings/index.html",
  "action": { "default_icon": { "128": "icons/icon.png" }, "default_title": "Dev Dashboard" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: blob: data:"
  }
}
